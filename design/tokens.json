    "zone4": { "dark": "#D94D82", "light": "#D94D84" },
    "zone5": { "dark": "#FF5C93", "light": "#D02868" },
    "bandStrap": { "dark": "#33363D", "light": "#2C2F36", "note": "BandRender: strap stubs" },
