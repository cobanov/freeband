    "hairlineStrong": { "dark": "#2B3442", "light": "#CDD3DC", "darkContrast": "#647084", "lightContrast": "#7E8896", "note": "arc and slider tracks, chart baseline; contrast values (3:1 on surface) are a v3 addition" },
    "textPrimary": { "dark": "#F5F7FA", "light": "#0D1117", "note": "15.8:1 on surface" },
    "textBody": { "dark": "#C9D1DC", "light": "#2B3340" },
    "textSecondary": { "dark": "#93A0B2", "light": "#566173", "darkContrast": "#BCC6D4", "lightContrast": "#3E4756", "note": "axes, captions; 7.0 / 5.9:1 on surface" },
    "textTertiary": { "dark": "#5D6878", "light": "#8A94A3", "darkContrast": "#8490A2", "lightContrast": "#667080", "note": "placeholder and disabled only (fails 4.5:1 on purpose); contrast values are a v3 addition" },
    "action": { "dark": "#F5F7FA", "light": "#0D1117", "note": "primary buttons and on-state toggles only; never a text colour" },
