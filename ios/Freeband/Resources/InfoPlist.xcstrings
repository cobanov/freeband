          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband"
          }
        }
      }
    },
    "CFBundleName": {
      "comment": "Bundle name",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Freeband"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Privacy - Bluetooth Always Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Freeband uses Bluetooth to talk directly to the band on your wrist."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband, bileğindeki bantla doğrudan konuşmak için Bluetooth kullanır."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - Location When In Use Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "If you turn on Share location with the band, Freeband sends this phone's location to your band when the band asks for it. It goes nowhere else."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumu bantla paylaş'ı açarsan Freeband, bant istediğinde bu telefonun konumunu bandına gönderir. Başka hiçbir yere gitmez."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "HealthKit usage description required for distribution; Freeband requests no read access.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband uses HealthKit to export your band steps, heart rate, resting heart rate, blood oxygen and sleep stages to Apple Health. Freeband does not read health data."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband, bandının adım, nabız, dinlenik nabız, kandaki oksijen ve uyku evresi verilerini Apple Health’e aktarmak için HealthKit kullanır. Freeband sağlık verilerini okumaz."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Privacy - Health Update Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband writes your band steps, heart rate, resting heart rate, blood oxygen and sleep stages to Apple Health when you choose to export them."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Freeband, aktarmayı seçtiğinde bandının adım, nabız, dinlenik nabız, kandaki oksijen ve uyku evresi verilerini Apple Health’e yazar."
          }
        }
      }
    }
  },
  "version": "1.0"
}