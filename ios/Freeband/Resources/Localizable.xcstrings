            "value": "Yük"
          }
        }
      }
    },
    "Strain counts how hard your heart worked while you were awake, from 0 to 21.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük, uyanıkken kalbinin ne kadar çalıştığını 0 ile 21 arasında sayar."
          }
        }
      }
    },
    "Strain is 21 × ln(1 + load ÷ 25) ÷ ln 25, at most 21: a load of 100 is about 10.5, 200 about 14.3.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük = 21 × ln(1 + efor ÷ 25) ÷ ln 25, en fazla 21: 100 efor yaklaşık 10,5, 200 efor yaklaşık 14,3 eder."
          }
        }
      }
    },
    "Stress": {
