{
  "sourceLanguage": "en",
  "strings": {
    "%@ %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ above usual": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalden %@ yüksek"
          }
        }
      }
    },
    "%@ below usual": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalden %@ düşük"
          }
        }
      }
    },
    "%@ can't vibrate on request.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ istek üzerine titreyemez."
          }
        }
      }
    },
    "%@ day: %lld min in heart-rate zones, most of it in zone %lld.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük: %1$@. Nabız bölgelerinde %2$lld dk, çoğu %3$lld. bölgede."
          }
        }
      }
    },
    "%@ day: no time in heart-rate zones.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük: %@. Nabız bölgelerinde hiç vakit geçmedi."
          }
        }
      }
    },
