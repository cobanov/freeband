    },
    "You joined": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katıldın"
          }
        }
      }
    },
    "Your account, data and webhooks on the server are deleted for good. Data on this phone stays.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucudaki hesabın, verin ve webhook'ların kalıcı olarak silinir. Telefondaki veri kalır."
          }
        }
      }
    },
    "Your age is unknown, so maximum heart rate is assumed. Add your birth year in Profile.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşın bilinmediği için maksimum nabız varsayıldı. Doğum yılını Profil'e ekle."
          }
        }
      }
    },
    "Your band, only yours.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandın, sadece senin."
          }
