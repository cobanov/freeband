          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freeband, uygun bileklik adımlarını, nabzı ve uyku evrelerini Apple Health’e yazabilir. Apple Health verilerini asla okumaz."
          }
        }
      }
    },
    "Freeband can write eligible band steps, heart rate, resting heart rate, blood oxygen and sleep stages to Apple Health. It never reads Apple Health." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
